{
  "name": "@gmemo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "gmemo": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "dev:worker": "cf dev",
    "deploy": "cf deploy",
    "postinstall": "node -e \"import('./scripts/link-wrangler.mjs').catch(() => {})\""
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "cf": "^1.0.0-beta.14",
    "tsx": "^4.23.15",
    "wrangler": "^4.139.0"
  },
  "dependencies": {
    "@gmemo/core": "0.1.0",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
