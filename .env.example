# Domain the app is served on (HTTPS is required for passkeys).
GMEMO_DOMAIN=notes.example.com

# --- Local LLM (optional, e.g. the ollama service in docker-compose) ---
# GMEMO_LOCAL_LLM_URL=http://ollama:11434
# GMEMO_LOCAL_LLM_MODEL=qwen2.5:7b
# GMEMO_LOCAL_EMBED_MODEL=nomic-embed-text

# --- External LLM (optional). Only notes in folders you allow are ever sent. ---
# GMEMO_EXTERNAL_LLM_PROVIDER=anthropic   # anthropic | openai
# GMEMO_EXTERNAL_LLM_API_KEY=
# GMEMO_EXTERNAL_LLM_MODEL=claude-sonnet-5-5
