{
  "name": "ganesya-ai-memo",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted Markdown notes where AI agents propose changes like pull requests",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build -w @gmemo/core && npm run build -w @gmemo/server && npm run build -w @gmemo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run build -w @gmemo/core && npm run dev -w @gmemo/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "5.7",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
